{
  "name": "dsh-schedule-later",
  "version": "0.5.0",
  "description": "Schedule a message into a dsh chat for later: a Schedule button in the message box with a date and time picker, a sidebar panel of pending messages across chats, delivery as a normal user message even with the browser closed, and schedule_message, list_scheduled_messages and cancel_scheduled_message tools so the model can come back to a chat on its own.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "dsh.plugin.json",
    "screenshots.json"
  ],
  "scripts": {
    "build": "npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": []
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "schedule",
    "scheduled-send",
    "reminder",
    "timer",
    "tools",
    "skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adithyanraj03/dsh-schedule-later.git"
  },
  "homepage": "https://adithyanraj03.github.io/dsh-schedule-later/",
  "bugs": {
    "url": "https://github.com/adithyanraj03/dsh-schedule-later/issues"
  },
  "author": "Adithya N Raj (adithyanraj03)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
